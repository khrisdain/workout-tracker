# Copy to .env and adjust if the defaults clash with something already running.
# docker compose reads this file automatically; the applications read the same
# names through the ${...} placeholders in their YAML.

# ---- MySQL (primary application, prod profile) ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pulsetrack
MYSQL_USER=pulsetrack
MYSQL_PASSWORD=root
MYSQL_PORT=3306

# ---- PostgreSQL (nutrition service, qa profile) ----
POSTGRES_DB=nutritiondb
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition-pass
POSTGRES_PORT=5432

# ---- Adminer ----
ADMINER_PORT=8082

# ---- Credentials the primary app uses to call the microservice ----
NUTRITION_SERVICE_URL=http://localhost:8081
NUTRITION_SERVICE_USER=pulsetrack-app
NUTRITION_SERVICE_PASSWORD=app-secret
